      "case": "Inverse, G = 21,40 €",
      "currency": "EUR",
      "gross": "21.40",
      "reductions": {},
      "expected": { "net": "20.00", "commission": "1.40" }
    },
    {
      "case": "Inverse, G = 1,50 €",
      "currency": "EUR",
      "gross": "1.50",
      "reductions": {},
      "expected": { "net": "0.50", "commission": "1.00" }
    },
    {
      "case": "Inverse XOF, minimum, G = 5 650",
      "currency": "XOF",
      "gross": "5650",
      "reductions": {},
      "expected": { "net": "5000", "commission": "650" }
    },
    {
      "case": "Inverse XAF, tranche 1, G = 21 400",
      "currency": "XAF",
      "gross": "21400",
      "reductions": {},
      "expected": { "net": "20000", "commission": "1400" }
    },
    {
      "case": "Inverse, G = 1,00 € (budget au minimum)",
      "currency": "EUR",
      "gross": "1.00",
      "reductions": {},
      "expected": { "error": "budget-below-commission-minimum" }
    },
    {
      "case": "Inverse avec bon x0,5, G = 0,50 € (minimum effectif 1,00 € x 0,5)",
      "currency": "EUR",
      "gross": "0.50",
      "reductions": { "voucherFactor": "0.5" },
      "expected": { "error": "budget-below-commission-minimum" }
