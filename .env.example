# Copy this file to .env.dev and fill in real values, then `source .env.dev`.
# NEVER commit .env.dev — it is in .gitignore

# ─── App ─────────────────────────────────────────────────────────────────────
export APP_BASE_URL=http://localhost:8080

# ─── Database (défauts dev OK — surcharger si Postgres non standard) ─────────
# export POSTGRES_URL=jdbc:postgresql://localhost:5432/yadony_dev
# export POSTGRES_USER=yadony
# export POSTGRES_PASSWORD=yadony_dev_password

# ─── Stripe (test) ───────────────────────────────────────────────────────────
export STRIPE_SECRET_KEY=replace_me
export STRIPE_WEBHOOK_SECRET=replace_me
# Webhooks séparés (facultatif — retombent sur STRIPE_WEBHOOK_SECRET)
# export STRIPE_WEBHOOK_PAYMENTS_SECRET=replace_me
# export STRIPE_WEBHOOK_KYC_SECRET=replace_me

# ─── Cloudflare R2 ───────────────────────────────────────────────────────────
export AWS_S3_REGION=auto
export AWS_S3_BUCKET=yadony-app
export AWS_S3_ACCESS_KEY=replace_me
export AWS_S3_SECRET_KEY=replace_me
export AWS_S3_ENDPOINT=replace_me
# export STORAGE_PUBLIC_BASE_URL=https://yadony-storage.local

# ─── Google Places + Geocoding API ───────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# Enable: Places API + Geocoding API
# In prod: restrict to server IP (OVH fixed IP)
export GOOGLE_PLACES_API_KEY=replace_me

# ─── Encryption ──────────────────────────────────────────────────────────────
export ENCRYPTION_KEY=replace_me

# ─── Email (Resend — OTP de connexion) ───────────────────────────────────────
export RESEND_API_KEY=replace_me
# export YADONY_EMAIL_FROM_ADDRESS=noreply@yadony.com

# ─── Firebase ────────────────────────────────────────────────────────────────
# Clé d'API Web (Firebase Console > Paramètres du projet > Général) — requise
# pour GET /dev/token uniquement.
export FIREBASE_API_KEY=replace_me

