# ============================================
# .env — Template des secrets PRODUCTION
# ============================================
# Copier ce fichier en `.env` À CÔTÉ de docker-compose.prod.yml sur le VPS.
# DO NOT commit .env — secret local au serveur.
#
# Ce fichier est chargé DEUX fois :
#   1. implicitement par `docker compose -f docker-compose.prod.yml` —
#      substitution des ${VAR} du compose (DB du conteneur postgres, Grafana…)
#   2. `env_file: .env` sur le service api — injection directe dans le
#      conteneur. Toute variable ajoutée ici atteint Spring sans toucher au compose.
# Format compose : KEY=VALUE, sans `export`.

# Image déployée (tag GHCR — défaut latest)
# YADONY_IMAGE_TAG=latest

# Database
DB_USERNAME=yadony
DB_PASSWORD=change_me
# SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/yadony_prod

# Encryption (AES-256 base64, 32 bytes = 44 chars) — REQUIS, l'app ne boote pas sans
ENCRYPTION_KEY=change_me

# Stripe (clés LIVE)
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
STRIPE_WEBHOOK_PAYMENTS_SECRET=whsec_xxxxxxxxxxxx
STRIPE_WEBHOOK_KYC_SECRET=whsec_xxxxxxxxxxxx

# Email (Resend — OTP de connexion)
RESEND_API_KEY=re_xxxxxxxxxxxx
# YADONY_EMAIL_FROM_ADDRESS=noreply@yadony.com

# CORS — origines du back-office admin (REQUIS depuis que la propriété est lue)
CORS_ALLOWED_ORIGINS=https://admin.yadony.com

# App
APP_BASE_URL=https://api.yadony.com
# Domaine nu, sans /api/v1 : c'est ce qui rend l'URL de l'affiche partageable
# lisible (yadony.com/annonce/{id} au lieu de api.yadony.com/api/v1/...).
# Nginx doit porter la règle de réécriture correspondante (voir nginx/nginx.conf,
# bloc "Public trip poster page") — sans elle, cette URL renvoie une 404.
#
# En déploiement réel, cette valeur vient de la variable GitHub du même nom
# (Settings > Environments > production > Variables), que le workflow recopie
# dans ce fichier. Ce template ne sert qu'aux déploiements manuels.
PUBLIC_BASE_URL=https://yadony.com

# Fiches stores de la page publique d'annonce. Les trois vont ENSEMBLE, à
# renseigner le jour de la publication de l'application :
# STORE_OS_REDIRECT_ENABLED bascule le bouton principal vers le store du
# système détecté (Android/iOS) au lieu du lien dony://. Laissées vides, le
# bouton garde son comportement actuel — jamais de bouton mort.
# STORE_URL_ANDROID=https://play.google.com/store/apps/details?id=com.yadony.yadony
# STORE_URL_IOS=https://apps.apple.com/app/yadony/idXXXXXXXXX
# STORE_OS_REDIRECT_ENABLED=true

# Google Places API (restreinte à l'IP du serveur)
GOOGLE_PLACES_API_KEY=AIzaSyDxxxxxxxxxxxxxxxx

# Cloudflare R2 (S3-compatible)
AWS_S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
AWS_S3_REGION=auto
AWS_S3_BUCKET=yadony-prod
AWS_S3_ACCESS_KEY=change_me
AWS_S3_SECRET_KEY=change_me

# Monitoring
SENTRY_DSN=https://xxxx@sentry.io/xxxxx
GRAFANA_PROM_URL=https://prometheus-blocks-prod-us-central1.grafana.net/api/prom/push
GRAFANA_PROM_USER=your_prom_user
GRAFANA_LOKI_URL=https://logs-prod-us-central1.grafana.net/loki/api/v1/push
GRAFANA_LOKI_USER=your_loki_user
GRAFANA_CLOUD_TOKEN=your_grafana_token

# Internal API secrets
INTERNAL_SHARED_SECRET=change_me

# Mobile money (facultatif)
# WAVE_API_KEY=
# WAVE_WEBHOOK_SECRET=
# ORANGE_MONEY_API_KEY=
# ORANGE_MONEY_WEBHOOK_SECRET=

# SMS (facultatif)
# SMS_ENABLED=true
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
